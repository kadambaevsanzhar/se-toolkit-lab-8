{
  "agents": {
    "defaults": {
      "workspace": "/app/nanobot/workspace",
      "model": "deepseek/deepseek-chat",
      "provider": "custom",
      "maxTokens": 8192,
      "contextWindowTokens": 65536,
      "temperature": 0.1,
      "maxToolIterations": 20,
      "reasoningEffort": null,
      "timezone": "UTC"
    }
  },
  "channels": {
    "webchat": {
      "enabled": true,
      "allowFrom": [
        "*"
      ],
      "host": "0.0.0.0",
      "port": 8765,
      "accessKey": "my_secret_api_key_2"
    },
    "sendProgress": true,
    "sendToolHints": false,
    "sendMaxRetries": 3
  },
  "providers": {
    "custom": {
      "apiKey": "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",
      "apiBase": "https://openrouter.ai/api/v1",
      "extraHeaders": null
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790,
    "heartbeat": {
      "enabled": true,
      "intervalS": 1800,
      "keepRecentMessages": 8
    }
  },
  "tools": {
    "web": {
      "proxy": null,
      "search": {
        "provider": "brave",
        "apiKey": "",
        "baseUrl": "",
        "maxResults": 5
      }
    },
    "exec": {
      "enable": false,
      "timeout": 60,
      "pathAppend": ""
    },
    "restrictToWorkspace": true,
    "mcpServers": {
      "lms": {
        "command": "python3",
        "args": [
          "-m",
          "mcp_lms"
        ],
        "env": {
          "NANOBOT_LMS_BACKEND_URL": "http://backend:8000",
          "NANOBOT_LMS_API_KEY": "my_secret_api_key"
        }
      },
      "webchat": {
        "command": "python3",
        "args": [
          "-m",
          "mcp_webchat"
        ],
        "env": {
          "NANOBOT_WEBCHAT_UI_RELAY_URL": "ws://127.0.0.1:8765",
          "NANOBOT_WEBCHAT_UI_TOKEN": "my_secret_api_key_2",
          "NANOBOT_ACCESS_KEY": "my_secret_api_key_2"
        }
      }
    }
  }
}
