{
  "agents": {
    "defaults": {
      "workspace": "/tmp/nanobot-runtime",
      "model": "coder-model",
      "provider": "custom",
      "maxTokens": 8192,
      "contextWindowTokens": 65536,
      "temperature": 0.1,
      "maxToolIterations": 20,
      "reasoningEffort": null,
      "timezone": "UTC"
    }
  },
  "channels": {
    "webchat": {
      "enabled": true,
      "allowFrom": ["*"],
      "host": "0.0.0.0",
      "port": 8765
    },
    "sendProgress": true,
    "sendToolHints": false,
    "sendMaxRetries": 3
  },
  "providers": {
    "custom": {
      "apiKey": "",
      "apiBase": "",
      "extraHeaders": null
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790,
    "heartbeat": {
      "enabled": true,
      "intervalS": 1800,
      "keepRecentMessages": 8
    }
  },
  "tools": {
    "web": {
      "proxy": null,
      "search": {
        "provider": "brave",
        "apiKey": "",
        "baseUrl": "",
        "maxResults": 5
      }
    },
    "exec": {
      "enable": false,
      "timeout": 60,
      "pathAppend": ""
    },
    "restrictToWorkspace": true,
    "mcpServers": {
      "lms": {
        "command": "python3",
        "args": ["-m", "mcp_lms"],
        "env": {
          "NANOBOT_LMS_BACKEND_URL": "",
          "NANOBOT_LMS_API_KEY": ""
        }
      },
      "webchat": {
        "command": "python3",
        "args": ["-m", "mcp_webchat"],
        "env": {
          "NANOBOT_WEBCHAT_UI_RELAY_URL": "",
          "NANOBOT_WEBCHAT_UI_TOKEN": "",
          "NANOBOT_ACCESS_KEY": ""
        }
      }
    }
  }
}
